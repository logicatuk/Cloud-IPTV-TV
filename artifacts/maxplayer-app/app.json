{
  "expo": {
    "name": "MaxPlayer TV App",
    "slug": "maxplayer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maxplayer-app",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#0F0F0F",
      "package": "com.aessmaki.maxplayerapp"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "backgroundColor": "#0F0F0F"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a1ac0abb-1475-41d7-89d1-ae4914b8e6c5"
      }
    }
  }
}
